MCP_SERVER_URL=http://127.0.0.1:7071/mcp
SERVICE_BUS_CONNECTION=
PIPELINE_QUEUE_NAME=cope-requests
PIPELINE_FUNCTION_REPO=../pipeline-function

# Azure SDK auth for the live pipeline fallback and Cope end-to-end scenario.
# In CI these tests use GitHub OIDC federated identity instead, so no secret is stored;
# locally, leave AZURE_CLIENT_SECRET empty to fall back to `az login`.
SERVICE_BUS_NAMESPACE_FQDN=pocsb.servicebus.windows.net
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
STORAGE_ACCOUNT_URL=https://pocsa.blob.core.windows.net
COPE_QUEUE_NAME=cope_request
OUTPUT_POLL_INTERVAL_MS=5000

# Non-UI NotificationLog integration (requires Service Bus Data Sender and Table Data Reader).
NOTIFICATION_SERVICE_BUS_NAMESPACE_FQDN=sb-sn-data-dev.servicebus.windows.net
NOTIFICATION_QUEUE_NAME=cope-requests
NOTIFICATION_TABLE_ACCOUNT_URL=https://stsndatadevvaike.table.core.windows.net
NOTIFICATION_TABLE_NAME=NotificationLog
# Optional dedicated credentials; otherwise use Azure identity from `az login` / OIDC.
NOTIFICATION_SERVICE_BUS_CONNECTION=
NOTIFICATION_TABLE_CONNECTION_STRING=

# Fallback when creating an app registration or assigning RBAC needs an administrator.
# These are long-lived shared secrets - prefer the OIDC path above where possible.
SERVICE_BUS_CONNECTION=
STORAGE_SAS_URL=

# SAS-over-REST scenario. "bulk-send-key" is a queue-scoped policy, so each queue has its own
# primary key - copy each from <queue> > Shared access policies > bulk-send-key. The Send claim
# does not allow peeking, so the peek step uses SERVICE_BUS_LISTEN_CONNECTION or `az login`.
# SERVICE_BUS_SAS_KEY_<QUEUE> wins over the generic SERVICE_BUS_SAS_KEY fallback.
SERVICE_BUS_SAS_KEY_NAME=bulk-send-key
SERVICE_BUS_SAS_KEY_COPE_REQUESTS=
SERVICE_BUS_SAS_KEY_COPE_REQUESTS_DEV=
SERVICE_BUS_SAS_KEY=
SERVICE_BUS_SAS_TTL_SECONDS=3600
SERVICE_BUS_LISTEN_CONNECTION=
SERVICE_BUS_PEEK_MAX_MESSAGES=32
SERVICE_BUS_PEEK_INTERVAL_MS=5000

# Azure Portal UI scenario - dedicated automation account with an authenticator app
# enrolled. A fresh TOTP code is generated per run, so there is no session to expire.
AZURE_PORTAL_USERNAME=
AZURE_PORTAL_PASSWORD=
TOTP_SECRET=
AZURE_PORTAL_HEADLESS=false